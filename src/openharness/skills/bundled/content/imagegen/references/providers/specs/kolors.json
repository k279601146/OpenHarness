{
  "model_ids": ["kolors"],
  "provider": "kolors",
  "api_model_default": "Kwai-Kolors/Kolors",
  "default_base_url": "https://api.packyapi.com/v1",
  "count_field": "batch_size",
  "size_field": "image_size",
  "aspect_to_size": {
    "1:1": "1024x1024",
    "3:4": "960x1280",
    "1:2": "720x1440",
    "9:16": "720x1280"
  },
  "derive_size_from_aspect": true,
  "safe_optional_fields": [
    "negative_prompt",
    "seed",
    "num_inference_steps",
    "guidance_scale"
  ],
  "optional_field_aliases": {
    "negative": "negative_prompt"
  },
  "default_execution_parameters": {
    "image_size": "1024x1024",
    "batch_size": 1
  },
  "max_outputs": 4,
  "defaults": {
    "resolution": "1K",
    "size": "1024x1024",
    "aspect_ratio": "1:1",
    "quality": "medium"
  },
  "supports": {
    "edit": false,
    "reference": false,
    "batch": true
  }
}
